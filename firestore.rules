rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Hardened Global Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // 3. Entity Validation Blueprints (Synchronized with firebase-blueprint.json)
    function isValidPilotProfile(data) {
      return data.keys().hasAll([
          'uid', 'pilotName', 'pilotId', 'operatorId',
          'droneSn', 'droneMake', 'droneModel',
          'avatarDataUrl', 'licenseUrl', 'registrationUrl', 'insuranceUrl',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'pilotName', 'pilotId', 'operatorId',
          'droneSn', 'droneMake', 'droneModel',
          'avatarDataUrl', 'licenseUrl', 'registrationUrl', 'insuranceUrl',
          'createdAt', 'updatedAt'
        ])
        && data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid.matches('^[a-zA-Z0-9_\\-]+$')
        && data.uid == request.auth.uid
        && data.pilotName is string && data.pilotName.size() >= 1 && data.pilotName.size() <= 100
        && data.pilotId is string && data.pilotId.size() <= 80
        && data.operatorId is string && data.operatorId.size() <= 80
        && data.droneSn is string && data.droneSn.size() <= 80
        && data.droneMake is string && data.droneMake.size() <= 80
        && data.droneModel is string && data.droneModel.size() <= 80
        && data.avatarDataUrl is string && data.avatarDataUrl.size() <= 250000
        && data.licenseUrl is string && data.licenseUrl.size() <= 500
        && data.registrationUrl is string && data.registrationUrl.size() <= 500
        && data.insuranceUrl is string && data.insuranceUrl.size() <= 500
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPilotDocument(data) {
      return data.keys().hasAll([
          'ownerId', 'docType', 'fileName', 'mimeType',
          'fileDataUrl', 'externalUrl', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'docType', 'fileName', 'mimeType',
          'fileDataUrl', 'externalUrl', 'docNumber', 'validUntil',
          'createdAt', 'updatedAt'
        ])
        && data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.ownerId == request.auth.uid
        && data.docType is string && data.docType.size() <= 30 && data.docType in ['license', 'registration', 'insurance']
        && data.fileName is string && data.fileName.size() <= 200
        && data.mimeType is string && data.mimeType.size() <= 100
        && data.fileDataUrl is string && data.fileDataUrl.size() <= 600000
        && data.externalUrl is string && data.externalUrl.size() <= 500
        && (!('docNumber' in data) || (data.docNumber is string && data.docNumber.size() <= 80))
        && (!('validUntil' in data) || (data.validUntil is string && data.validUntil.size() <= 40))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidFlightRecord(data) {
      return data.keys().hasAll([
          'ownerId', 'location', 'takeoffTime', 'landingTime',
          'durationMin', 'radiusM', 'droneSn', 'droneMake', 'droneModel',
          'checklistCompleted', 'notes', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'location', 'latitude', 'longitude',
          'takeoffTime', 'landingTime', 'durationMin', 'radiusM',
          'droneSn', 'droneMake', 'droneModel',
          'checklistCompleted', 'notes', 'createdAt', 'updatedAt'
        ])
        && data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.ownerId == request.auth.uid
        && data.location is string && data.location.size() >= 1 && data.location.size() <= 300
        && (!('latitude' in data) || (data.latitude is number && data.latitude >= -90 && data.latitude <= 90))
        && (!('longitude' in data) || (data.longitude is number && data.longitude >= -180 && data.longitude <= 180))
        && data.takeoffTime is string && data.takeoffTime.size() >= 1 && data.takeoffTime.size() <= 64
        && data.landingTime is string && data.landingTime.size() >= 1 && data.landingTime.size() <= 64
        && data.durationMin is number && data.durationMin >= 0 && data.durationMin <= 1440
        && data.radiusM is number && data.radiusM >= 50 && data.radiusM <= 5000
        && data.droneSn is string && data.droneSn.size() <= 80
        && data.droneMake is string && data.droneMake.size() <= 80
        && data.droneModel is string && data.droneModel.size() <= 80
        && data.checklistCompleted is bool
        && data.notes is string && data.notes.size() <= 1000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidMaintenanceRecord(data) {
      return data.keys().hasAll([
          'ownerId', 'serviceDate', 'category', 'droneSn',
          'description', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'serviceDate', 'category', 'droneSn',
          'description', 'createdAt', 'updatedAt'
        ])
        && data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.ownerId == request.auth.uid
        && data.serviceDate is string && data.serviceDate.size() >= 1 && data.serviceDate.size() <= 40
        && data.category is string && data.category.size() >= 1 && data.category.size() <= 60
        && data.droneSn is string && data.droneSn.size() <= 80
        && data.description is string && data.description.size() >= 1 && data.description.size() <= 1000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCountryRule(data) {
      return data.keys().hasAll([
          'ownerId', 'country', 'regulator', 'easa',
          'maxHeight', 'insurance', 'appLink', 'prohibited',
          'notes', 'instructions', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'country', 'regulator', 'easa',
          'maxHeight', 'insurance', 'appLink', 'prohibited',
          'notes', 'instructions', 'createdAt', 'updatedAt'
        ])
        && data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.ownerId == request.auth.uid
        && data.country is string && data.country.size() >= 1 && data.country.size() <= 100
        && data.regulator is string && data.regulator.size() <= 120
        && data.easa is string && data.easa.size() <= 30 && data.easa in ['Da', 'Ne', 'Djelomično']
        && data.maxHeight is string && data.maxHeight.size() <= 60
        && data.insurance is string && data.insurance.size() <= 120
        && data.appLink is string && data.appLink.size() <= 500
        && data.prohibited is string && data.prohibited.size() <= 600
        && data.notes is string && data.notes.size() <= 1500
        && data.instructions is string && data.instructions.size() <= 2000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // 4. Collection Match Blocks
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
      allow list: if false;
      allow create: if isVerified()
        && isValidId(userId)
        && request.auth.uid == userId
        && isValidPilotProfile(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerified()
        && isValidId(userId)
        && request.auth.uid == userId
        && isValidPilotProfile(incoming())
        && existing().uid == request.auth.uid
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          incoming().diff(existing()).affectedKeys().hasOnly([
            'pilotName', 'pilotId', 'operatorId',
            'droneSn', 'droneMake', 'droneModel',
            'avatarDataUrl', 'licenseUrl', 'registrationUrl', 'insuranceUrl',
            'updatedAt'
          ])
        );
      allow delete: if isVerified() && isValidId(userId) && request.auth.uid == userId;
    }

    match /pilotDocs/{docId} {
      allow get: if isSignedIn() && isValidId(docId) && existing().ownerId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isVerified()
        && isValidId(docId)
        && isValidPilotDocument(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerified()
        && isValidId(docId)
        && isValidPilotDocument(incoming())
        && existing().ownerId == request.auth.uid
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          incoming().diff(existing()).affectedKeys().hasOnly([
            'docType', 'fileName', 'mimeType', 'fileDataUrl', 'externalUrl',
            'docNumber', 'validUntil', 'updatedAt'
          ])
        );
      allow delete: if isVerified() && isValidId(docId) && existing().ownerId == request.auth.uid;
    }

    match /flights/{flightId} {
      allow get: if isSignedIn() && isValidId(flightId) && existing().ownerId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isVerified()
        && isValidId(flightId)
        && isValidFlightRecord(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerified()
        && isValidId(flightId)
        && isValidFlightRecord(incoming())
        && existing().ownerId == request.auth.uid
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          incoming().diff(existing()).affectedKeys().hasOnly([
            'location', 'latitude', 'longitude',
            'takeoffTime', 'landingTime', 'durationMin', 'radiusM',
            'droneSn', 'droneMake', 'droneModel',
            'checklistCompleted', 'notes', 'updatedAt'
          ])
        );
      allow delete: if isVerified() && isValidId(flightId) && existing().ownerId == request.auth.uid;
    }

    match /maintenance/{maintenanceId} {
      allow get: if isSignedIn() && isValidId(maintenanceId) && existing().ownerId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isVerified()
        && isValidId(maintenanceId)
        && isValidMaintenanceRecord(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerified()
        && isValidId(maintenanceId)
        && isValidMaintenanceRecord(incoming())
        && existing().ownerId == request.auth.uid
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          incoming().diff(existing()).affectedKeys().hasOnly([
            'serviceDate', 'category', 'droneSn', 'description', 'updatedAt'
          ])
        );
      allow delete: if isVerified() && isValidId(maintenanceId) && existing().ownerId == request.auth.uid;
    }

    match /countryRules/{ruleId} {
      allow get: if isSignedIn() && isValidId(ruleId) && existing().ownerId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isVerified()
        && isValidId(ruleId)
        && isValidCountryRule(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerified()
        && isValidId(ruleId)
        && isValidCountryRule(incoming())
        && existing().ownerId == request.auth.uid
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          incoming().diff(existing()).affectedKeys().hasOnly([
            'country', 'regulator', 'easa', 'maxHeight',
            'insurance', 'appLink', 'prohibited', 'notes',
            'instructions', 'updatedAt'
          ])
        );
      allow delete: if isVerified() && isValidId(ruleId) && existing().ownerId == request.auth.uid;
    }
  }
}
